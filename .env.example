# Copy to .env and fill in. Never commit .env.

# Administrator (managed only here, not through the panel)
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Single timezone for all due dates
TIMEZONE=Europe/Moscow
# Reminders are sent 3 days before the due date at this hour (payments added later are reminded immediately)
REMINDER_HOUR=10
# Public URL of the panel: links in messages and the .ics calendar feed
PUBLIC_URL=http://localhost:8080

# Telegram bot (@BotFather) and the chat that receives reminders; the bot only answers in this chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP for e-mail notifications to people responsible for a payment (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# Demo data (users, categories, payments in RUB/USD/EUR) on first start with an empty database
SEED_DEMO=true

# deploy.compose.yaml only
HOSTNAME=invoices.example.com
POSTGRES_PASSWORD=change-me

# Host port for compose.yaml
PORT=8080
